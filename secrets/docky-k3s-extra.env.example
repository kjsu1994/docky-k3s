# Copy this file to C:\secret\docky-k3s-extra.env and fill real values.
# Do not store filled secret files under C:\compose, C:\K3s, or source control.
# Values in this file override C:\compose\.env when generating runtime/docky-secret.yml.

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Oracle / application datasource
ORACLE_PASSWORD=
ORACLE_APP_USER=SCOTT_V1
ORACLE_APP_USER_PASSWORD=
SPRING_DATASOURCE_USERNAME=SCOTT_V1
SPRING_DATASOURCE_PASSWORD=

# MinIO / S3
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Application security
JWT_SECRET_KEY=

# OAuth / external APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
DART_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=

# Mail
MAIL_ADDRESS_MASTER=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=